<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.study.demo.auth.mapper.DemoAuthAccountMapper">

    <resultMap id="DemoAuthAccountMap" type="com.example.study.demo.auth.entity.DemoAuthAccount">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="password" column="password"/>
        <result property="enabled" column="enabled"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <select id="selectEnabledByUsername" resultMap="DemoAuthAccountMap">
        SELECT id, username, password, enabled, create_time, update_time
        FROM demo_auth_account
        WHERE username = #{username}
          AND enabled = 1
        LIMIT 1
    </select>

    <select id="selectEnabledById" resultMap="DemoAuthAccountMap">
        SELECT id, username, password, enabled, create_time, update_time
        FROM demo_auth_account
        WHERE id = #{id}
          AND enabled = 1
        LIMIT 1
    </select>

    <select id="countByUsername" resultType="long">
        SELECT COUNT(1)
        FROM demo_auth_account
        WHERE username = #{username}
    </select>
</mapper>
