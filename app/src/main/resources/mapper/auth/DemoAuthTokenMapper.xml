<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.study.demo.auth.mapper.DemoAuthTokenMapper">

    <resultMap id="DemoAuthTokenMap" type="com.example.study.demo.auth.entity.DemoAuthToken">
        <id property="token" column="token"/>
        <result property="accountId" column="account_id"/>
        <result property="expiresAt" column="expires_at"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <select id="selectByToken" resultMap="DemoAuthTokenMap">
        SELECT token, account_id, expires_at, create_time
        FROM demo_auth_token
        WHERE token = #{token}
        LIMIT 1
    </select>
</mapper>
